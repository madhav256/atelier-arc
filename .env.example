# --- Core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/atelier_arc
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QUOTE_SECRET=
INVENTORY_HOLD_MINUTES=30
JOBS_ENABLED=true
SEED_PASSWORD=ChangeMe123!

# --- Payments: mock (local only) | stripe | razorpay ---
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email: console (logs + in-memory outbox) | smtp ---
EMAIL_PROVIDER=console
EMAIL_FROM=Atelier Arc <no-reply@atelierarc.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Images: local | cloudinary ---
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional self-hosted malware scan (docker run -p 3310:3310 clamav/clamav)
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Search: mongo | atlas ---
SEARCH_PROVIDER=mongo
ATLAS_SEARCH_INDEX=artworks

# --- Commerce rules ---
ORIGIN_COUNTRY=IN
DOMESTIC_TAX_RATE=0.12
INSURANCE_RATE=0.01

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api/v1
# Advisor WhatsApp click-to-chat (wa.me, free, no API account). International format; empty hides the links.
# PLACEHOLDER: sample/testing number. Replace with the real advisor line before launch (also in frontend/.env.production).
VITE_ADVISOR_WHATSAPP=+16699377112
